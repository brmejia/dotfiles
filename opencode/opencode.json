{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "agent": {
    "build": { "color": "#E07040" },
    "plan": { "color": "#8EBA89" },
    "explore": { "hidden": false },
    "general": { "hidden": false }
  },
  "instructions": [
    "./instructions/context7.md",
    "./instructions/git-commit-rules.md",
    "./instructions/shell-preferences.md"
  ],
  "mcp": {
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "minimax-coding-plan": {
      "command": ["uvx", "minimax-coding-plan-mcp", "-y"],
      "enabled": false,
      "type": "local"
    }
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "bash *skills/context-file-creation-v4/cleanup.sh *": "allow",
      "bash *skills/context-file-creation-v4/create_context.sh *": "allow",
      "bash *skills/context-file-creation-v4/write_content.sh *": "allow",
      "cargo all-features test *": "allow",
      "cargo check *": "allow",
      "cargo clippy *": "allow",
      "cargo nextest *": "allow",
      "cargo test *": "allow",
      "cat *": "deny",
      "echo *": "allow",
      "git branch --current": "allow",
      "git branch --list": "allow",
      "git branch --show-current": "allow",
      "git branch -a": "allow",
      "git commit *": "ask",
      "git diff *": "allow",
      "git log *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote -v 2>*": "allow",
      "git remote get-url *": "allow",
      "git remote get-url --push *": "allow",
      "git remote get-url --all *": "allow",
      "git remote show *": "allow",
      "git remote -v show *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "eza *": "allow",
      "mise use *": "allow",
      "mkdir *": "allow",
      "mktemp *": "allow",
      "pre-commit run *": "allow",
      "prek run *": "allow",
      "printf *": "allow",
      "pwd *": "allow",
      "rm -f /tmp/*": "allow",
      "trap 'rm -f \"$CONTEXT_FILE\"' INT TERM": "allow",
      "wc *": "allow",
      "rtk *": "allow",
      "rtk kubectl*": "ask",
      "rtk git commit *": "ask",
      "openspec *": "allow",
      "glab ci list *": "allow",
      "glab ci view *": "allow",
      "glab issue list *": "allow",
      "glab issue view *": "allow",
      "glab mr list *": "allow",
      "glab mr view *": "allow",
      "glab project list *": "allow",
      "glab project view *": "allow",
      "glab release list *": "allow",
      "glab release view *": "allow",
      "glab user *": "allow",
      "glab version": "allow"
    },
    "doom_loop": "deny",
    "edit": {
      "*": "ask",
      "openspec/*": "allow",
      ".planning/*": "allow",
      ".tmp/**": "allow",
      "/tmp/*": "allow",
      "~/.config/opencode/*": "allow",
      "~/.dotfiles/opencode/*": "allow",
      "~/.agents/*": "allow"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "~/.config/opencode/*": "allow",
      "~/.dotfiles/*": "allow",
      "~/.agents/*": "allow",
      "~/.dotfiles/opencode/*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "env.nu": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.id_ed25519": "deny",
      "*.id_rsa": "deny",
      "*.key": "deny",
      "*.pem": "deny"
    },
    "skill": {
      "*": "ask",
      "openspec*": "allow",
      "grill-me*": "allow",
      "grill-with-docs*": "allow",
      "llm-guidelines*": "allow",
      "smart-commit": "allow",
      "tdd*": "allow",
      "update-mpocock-skills": "allow",
      "write-a-skill*": "allow"
    },
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "write": {
      "*": "ask",
      "openspec/*": "allow",
      ".planning/*": "allow",
      "/tmp/*": "allow",
      "~/.config/opencode/*": "allow",
      "~/.dotfiles/opencode/*": "allow"
    }
  },
  "provider": {
    "lmstudio": {
      "models": {
        "qwen3.5:0.8b": {
          "name": "qwen3.5:0.8b"
        },
        "qwen3.5:4b": {
          "_launch": true,
          "name": "Qwen3.5-4B"
        },
        "qwen3.5:9b": {
          "name": "Qwen3.5-9B"
        }
      },
      "name": "LM Studio (Local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      }
    },
    "ollama": {
      "models": {
        "qwen3.5:0.8b": {
          "name": "Qwen3.5-0.8B"
        },
        "qwen3.5:9b-q4_K_M": {
          "name": "Qwen3.5-9B"
        },
        "qwen3.5:4b-q4_K_M": {
          "name": "Qwen3.5-4B"
        },
        "qwen3.5:2b": {
          "_launch": true,
          "name": "Qwen3.5-2B"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  },
  "share": "disabled"
}
